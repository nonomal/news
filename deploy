#!/usr/bin/env bash
set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"

"$SCRIPT_DIR/gradlew" -p "$SCRIPT_DIR" assembleDebug assembleRelease

cp "$SCRIPT_DIR/app/build/outputs/apk/debug/app-debug.apk" "$SCRIPT_DIR/website/debug.apk"
cp "$SCRIPT_DIR/app/build/outputs/apk/release/app-release.apk" "$SCRIPT_DIR/website/release.apk"

rsync -avz --delete "$SCRIPT_DIR/website/" vesti:/srv/http/vestifeed.org/
